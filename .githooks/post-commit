#!/bin/sh
# aq post-commit hook — announce what you just committed
#
# Completes the announce lifecycle: pre-commit = prosecuting,
# post-commit = done. If pre-commit announced, this closes it.

command -v aq >/dev/null 2>&1 || exit 0

FILES=$(git diff-tree --no-commit-id --name-only -r HEAD | paste -sd, -)
[ -z "$FILES" ] && exit 0

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
CONJECTURE=$(echo "$BRANCH" | grep -oE 'C-[0-9]+' || echo "C-0")
MSG=$(git log --format=%s -1 HEAD)

aq announce \
  -c "$CONJECTURE" \
  --claim "$MSG" \
  --phase proof \
  -f "$FILES" \
  --status done \
  2>/dev/null || true

exit 0
